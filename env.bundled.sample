# BoBSearch bundled-services sample.
# Copy to .env and run:
#   cp env.bundled.sample .env
#   docker compose --profile bundled up -d --build

APP_NAME=BoBSearch
APP_VERSION=1.0.17
APP_IMAGE=bobsearch:local
APP_CONTAINER_NAME=bobsearch
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_PORT=7788
APP_RESTART_POLICY=unless-stopped
APP_DATA_DIR=/app/data
APP_DATA_HOST_PATH=./data/bobsearch

WEB_USERNAME=admin
WEB_PASSWORD=change-me
SESSION_SECRET=change-me-long-random-value

PUID=1000
PGID=1000
TZ=Etc/UTC

JACKETT_URL=http://jackett:9117
JACKETT_API_KEY=change-me-after-jackett-starts
JACKETT_INDEXERS_DIR=/jackett-indexers
JACKETT_INDEXERS_HOST_PATH=./data/jackett/Jackett/Indexers
BUNDLED_JACKETT_CONFIG_HOST_PATH=./data/jackett

QBIT_URL=http://qbittorrent:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=change-me
QBIT_CATEGORY=movies-staging
QBIT_SAVE_PATH=/downloads/movies-staging
QBIT_DOWNLOADS_PATH=/downloads
QBIT_LOCAL_DOWNLOADS_PATH=/downloads
QBIT_DOWNLOADS_HOST_PATH=./downloads
QBIT_EXTRA_DOWNLOADS_PATH=/unused-extra-downloads
QBIT_EXTRA_LOCAL_DOWNLOADS_PATH=/downloads-extra
QBIT_EXTRA_DOWNLOADS_HOST_PATH=./downloads-extra
BUNDLED_QBIT_CONFIG_HOST_PATH=./data/qbittorrent/config

JELLYFIN_LIBRARY_PATH=/jellyfin/library
JELLYFIN_LIBRARY_HOST_PATH=./library

LLM_BASE_URL=http://your-openai-compatible-host:port/v1
LLM_API_KEY=change-me
LLM_MODEL=gpt-5.5
# Fallback can point to another OpenAI-compatible endpoint such as Ollama /v1.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

SEARCH_CONCURRENCY=8
INDEXER_TIMEOUT_SECONDS=12
TOTAL_TIMEOUT_SECONDS=45
SEARCH_HISTORY_PATH=/app/data/search-history.json
SEARCH_HISTORY_LIMIT=30

# Optional remote deploy helper. Leave empty if unused.
DEPLOY_SSH_USER=
DEPLOY_SSH_HOST=
DEPLOY_TARGET_DIR=
DEPLOY_SSH_PASSWORD=
DEPLOY_SSH_PASSWORD_KEYCHAIN_ACCOUNT=
DEPLOY_SSH_PASSWORD_KEYCHAIN_SERVICE=
COMPOSE_PROFILES=bundled
PUBLISH_DOCKERHUB=0
DOCKERHUB_USER=
DOCKERHUB_PASSWORD=
DOCKERHUB_PASSWORD_KEYCHAIN_ACCOUNT=
DOCKERHUB_PASSWORD_KEYCHAIN_SERVICE=
